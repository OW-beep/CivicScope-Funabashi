# このファイルはテンプレートです。実際の値は .env.local に書いてください（gitには含めません）。

# e-Stat（政府統計の総合窓口）のアプリケーションID。
# https://www.e-stat.go.jp/mypage/api-user-registration で無料登録すると発行されます。
# /district-explorer の人口・世帯数表示に使います（未設定でも施設分布の表示自体は動きます）。
ESTAT_APP_ID=

# 楽天ウェブサービス（https://webservice.rakuten.co.jp/）のアプリID・アクセスキー。
# 2026年の新認証基盤ではRAKUTEN_ACCESS_KEYも必須（RAKUTEN_APP_IDだけでは動かない）。
# 両方未設定でも/recommended-disaster-goodsなど他ページは問題なく動く（楽天の商品カードだけ非表示になる）。
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 未設定でも動くが、設定するとクリックからの購入で紹介料が発生するアフィリエイトリンクになる。
# https://affiliate.rakuten.co.jp/ で発行。
RAKUTEN_AFFILIATE_ID=
